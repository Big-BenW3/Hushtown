# Copy to .env.local. Every value is optional; defaults are shown.

# Port for `npm run dev` / `npm start` is set by Next.js (PORT=3000).

# Shrinks every phase timer by this factor (0.02 to 1). Used by the Playwright suite.
# Used by the Playwright suite. NEVER enable in production.
# HUSHTOWN_TIME_SCALE=0.1
